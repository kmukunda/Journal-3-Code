import numpy as np
import pandas as pd
import torch
import torch.nn as nn
import torch.optim as optim
from sklearn.preprocessing import MinMaxScaler, StandardScaler, RobustScaler, QuantileTransformer
from sklearn.isotonic import IsotonicRegression
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import roc_auc_score, precision_recall_curve, brier_score_loss
from scipy.stats import norm

# Set random seeds for strict reproducibility
np.random.seed(42)
torch.manual_seed(42)

# =====================================================================
# 1. DATASET GENERATION & PREPROCESSING PIPELINE
# =====================================================================

def generate_telemetry_dataset(n_samples=25000):
    """
    Generates 25,000 synthetic MLOps telemetry records modeled after
    representative operational distributions (latency, drift, coverage).
    """
    timestamps = pd.date_range(start="2026-01-01", periods=n_samples, freq="5min")
    
    # x1: Infrastructure Latency (ms) - Log-Normal with 3% SLA spike anomalies
    base_lat = np.random.lognormal(mean=5.0, sigma=0.6, size=n_samples) # ~150ms mean
    spikes = np.random.rand(n_samples) < 0.03
    base_lat[spikes] += np.random.uniform(1500, 3500, size=np.sum(spikes))
    latency_ms = np.clip(base_lat, 10.0, 5000.0)
    
    # x2: Model Data Drift (KS statistic in [0, 1]) - Non-stationary temporal trend
    trend = np.linspace(0.1, 0.5, n_samples)
    ks_drift = np.clip(trend + np.random.normal(0.0, 0.15, size=n_samples), 0.0, 1.0)
    
    # x3: Code Coverage (%) - Gaussian deployment metric
    code_coverage = np.clip(np.random.normal(82.0, 8.0, size=n_samples), 50.0, 100.0)
    
    # Failure Label Y_t (Ground truth operational failure trigger)
    sla_breach = latency_ms > 2000.0
    drift_fail = (ks_drift > 0.65) & (code_coverage < 70.0)
    random_outage = np.random.rand(n_samples) < 0.005
    failure_label = (sla_breach | drift_fail | random_outage).astype(int)
    
    df = pd.DataFrame({
        'timestamp': timestamps,
        'latency_ms': latency_ms,
        'ks_drift': ks_drift,
        'code_coverage_pct': code_coverage,
        'failure_label': failure_label
    })
    return df

def generate_copula_stress_dataset(n_samples=100000):
    """
    Generates a 100,000-sample Gaussian Copula stress corpus for tail-risk testing.
    """
    mean = [0, 0, 0]
    cov = [
        [1.0,  0.4, -0.3],
        [0.4,  1.0, -0.2],
        [-0.3, -0.2, 1.0]
    ]
    mv = np.random.multivariate_normal(mean, cov, size=n_samples)
    u = norm.cdf(mv)
    
    latency_ms = np.exp(3.0 + u[:, 0] * 3.0)
    ks_drift = u[:, 1]
    code_coverage = 50.0 + u[:, 2] * 50.0
    
    fail_logits = -3.0 + 0.002 * latency_ms + 4.0 * ks_drift - 0.05 * code_coverage
    fail_prob = 1.0 / (1.0 + np.exp(-fail_logits))
    failure_label = (np.random.rand(n_samples) < fail_prob).astype(int)
    
    return pd.DataFrame({
        'latency_ms': latency_ms,
        'ks_drift': ks_drift,
        'code_coverage_pct': code_coverage,
        'failure_label': failure_label
    })

def preprocess_polarity_alignment(df):
    """
    Polarity Alignment g_i(x_i) = s_i * x_i
    Transforms all input signals so higher values consistently denote lower failure risk.
    """
    lat_norm = -1.0 * (df['latency_ms'].values / 2500.0) # s1 = -1
    drift_norm = -1.0 * (df['ks_drift'].values)           # s2 = -1
    cov_norm = (df['code_coverage_pct'].values - 50.0) / 50.0 # s3 = +1
    
    X = np.column_stack([lat_norm, drift_norm, cov_norm])
    y = df['failure_label'].values
    return X, y

# =====================================================================
# 2. PYTORCH NEURAL TELEMETRY CALIBRATION (NTC) MODULE
# =====================================================================

class NTCArchitecture(nn.Module):
    def __init__(self, input_dim=3, hidden_dim=16, constrained=True, coupled=True):
        super(NTCArchitecture, self).__init__()
        self.constrained = constrained
        self.coupled = coupled
        
        if coupled:
            # Layer 1 parameters
            self.V1 = nn.Parameter(torch.randn(input_dim, hidden_dim) * 0.1)
            self.b1 = nn.Parameter(torch.zeros(hidden_dim))
            # Layer 2 parameters
            self.V2 = nn.Parameter(torch.randn(hidden_dim, 1) * 0.1)
            self.b2 = nn.Parameter(torch.zeros(1))
        else:
            # Decoupled 1D Independent Feature Layers (Ablation B)
            self.V_dec = nn.Parameter(torch.randn(input_dim, 1) * 0.1)
            self.b_dec = nn.Parameter(torch.zeros(1))

    def forward(self, x):
        # Reparameterization for strictly positive weights W = exp(V) > 0
        if self.constrained:
            W1 = torch.exp(self.V1) if self.coupled else torch.exp(self.V_dec)
            W2 = torch.exp(self.V2) if self.coupled else None
        else:
            W1 = self.V1 if self.coupled else self.V_dec
            W2 = self.V2 if self.coupled else None

        if self.coupled:
            # Sigmoid activation guarantees strictly positive activation derivative
            h = torch.sigmoid(torch.matmul(x, W1) + self.b1)
            logits = torch.matmul(h, W2) + self.b2
            out_sig = torch.sigmoid(logits)
        else:
            out_sig = torch.sigmoid(torch.sum(x * W1.squeeze(), dim=1, keepdim=True) + self.b_dec)

        # Scale Mapping S = 1.00 + 4.00 * sigma(logits) in [1.00, 5.00]
        S = 1.00 + 4.00 * out_sig
        return S

def train_ntc_model(X_tr, y_tr, constrained=True, coupled=True, lambda_smooth=0.1, lambda_calib=0.01, lr=0.01, epochs=120):
    model = NTCArchitecture(input_dim=3, hidden_dim=16, constrained=constrained, coupled=coupled)
    optimizer = optim.Adam(model.parameters(), lr=lr)
    
    X_t = torch.tensor(X_tr, dtype=torch.float32)
    y_t = torch.tensor(y_tr, dtype=torch.float32).unsqueeze(1)
    
    for epoch in range(epochs):
        model.train()
        optimizer.zero_grad()
        
        S = model(X_t)
        
        # Recover Failure Probability P(Y=1|X) = (5.00 - S) / 4.00
        p_fail = torch.clamp((5.00 - S) / 4.00, 1e-6, 1.0 - 1e-6)
        
        # Loss Component 1: Task Binary Cross-Entropy
        l_task = nn.BCELoss()(p_fail, y_t)
        
        # Loss Component 2: Temporal Smoothness Penalty
        l_smooth = torch.mean((S[1:] - S[:-1]) ** 2) if lambda_smooth > 0 else torch.tensor(0.0)
        
        # Loss Component 3: Calibration Variance Regularization
        l_calib = -torch.var(S) if lambda_calib > 0 else torch.tensor(0.0)
        
        total_loss = l_task + (lambda_smooth * l_smooth) + (lambda_calib * l_calib)
        total_loss.backward()
        optimizer.step()
        
    return model

# =====================================================================
# 3. EVALUATION METRICS & BENCHMARK SUITE
# =====================================================================

def compute_evaluation_metrics(y_true, y_prob, S_sequence):
    """
    Computes ROC-AUC, Threshold-Optimized F1, Brier Calibration Score, and Temporal Jitter.
    """
    auc = roc_auc_score(y_true, y_prob)
    
    precisions, recalls, _ = precision_recall_curve(y_true, y_prob)
    f1_scores = 2 * (precisions * recalls) / (precisions + recalls + 1e-10)
    opt_f1 = np.max(f1_scores)
    
    brier = brier_score_loss(y_true, y_prob)
    jitter = np.mean((S_sequence[1:] - S_sequence[:-1]) ** 2) if len(S_sequence) > 1 else 0.0
    
    return auc, opt_f1, brier, jitter

def run_baseline_benchmarks(X_train_raw, y_train, X_test_raw, y_test, X_train_norm, X_test_norm, ntc_model):
    """
    Evaluates NTC against 6 standard scaling / normalization baselines.
    """
    baselines = {}
    
    # 1. Min-Max
    mm = MinMaxScaler().fit(X_train_raw)
    clf_mm = LogisticRegression().fit(mm.transform(X_train_raw), y_train)
    p_mm = clf_mm.predict_proba(mm.transform(X_test_raw))[:, 1]
    S_mm = 1.0 + 4.0 * (1.0 - p_mm)
    baselines['Min-Max'] = compute_evaluation_metrics(y_test, p_mm, S_mm)
    
    # 2. Z-Score
    zs = StandardScaler().fit(X_train_raw)
    clf_zs = LogisticRegression().fit(zs.transform(X_train_raw), y_train)
    p_zs = clf_zs.predict_proba(zs.transform(X_test_raw))[:, 1]
    S_zs = 1.0 + 4.0 * (1.0 - p_zs)
    baselines['Z-Score'] = compute_evaluation_metrics(y_test, p_zs, S_zs)
    
    # 3. Robust Scaler
    rs = RobustScaler().fit(X_train_raw)
    clf_rs = LogisticRegression().fit(rs.transform(X_train_raw), y_train)
    p_rs = clf_rs.predict_proba(rs.transform(X_test_raw))[:, 1]
    S_rs = 1.0 + 4.0 * (1.0 - p_rs)
    baselines['Robust Scaler'] = compute_evaluation_metrics(y_test, p_rs, S_rs)
    
    # 4. Quantile Transformer
    qt = QuantileTransformer(n_quantiles=1000, random_state=42).fit(X_train_raw)
    clf_qt = LogisticRegression().fit(qt.transform(X_train_raw), y_train)
    p_qt = clf_qt.predict_proba(qt.transform(X_test_raw))[:, 1]
    S_qt = 1.0 + 4.0 * (1.0 - p_qt)
    baselines['Quantile Transformer'] = compute_evaluation_metrics(y_test, p_qt, S_qt)
    
    # 5. Isotonic Regression
    iso_lat = IsotonicRegression(out_of_bounds='clip').fit(-X_train_raw[:, 0], y_train)
    iso_drift = IsotonicRegression(out_of_bounds='clip').fit(-X_train_raw[:, 1], y_train)
    iso_cov = IsotonicRegression(out_of_bounds='clip').fit(X_train_raw[:, 2], y_train)
    p_iso = (iso_lat.predict(-X_test_raw[:, 0]) + iso_drift.predict(-X_test_raw[:, 1]) + iso_cov.predict(X_test_raw[:, 2])) / 3.0
    S_iso = 1.0 + 4.0 * (1.0 - p_iso)
    baselines['Isotonic Regression'] = compute_evaluation_metrics(y_test, p_iso, S_iso)
    
    # 6. Unconstrained NN
    nn_unc = train_ntc_model(X_train_norm, y_train, constrained=False, coupled=True, lambda_smooth=0.0, lambda_calib=0.0)
    with torch.no_grad():
        S_unc = nn_unc(torch.tensor(X_test_norm, dtype=torch.float32)).numpy().flatten()
        p_unc = np.clip((5.0 - S_unc) / 4.0, 0, 1)
    baselines['Unconstrained NN'] = compute_evaluation_metrics(y_test, p_unc, S_unc)
    
    # 7. Proposed NTC
    with torch.no_grad():
        S_ntc = ntc_model(torch.tensor(X_test_norm, dtype=torch.float32)).numpy().flatten()
        p_ntc = np.clip((5.0 - S_ntc) / 4.0, 0, 1)
    baselines['NTC (Proposed)'] = compute_evaluation_metrics(y_test, p_ntc, S_ntc)
    
    return pd.DataFrame(baselines, index=['ROC-AUC', 'F1-Score (Opt)', 'Brier Score (Calib)', 'Temporal Jitter']).T

